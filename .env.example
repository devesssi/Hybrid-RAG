# Required application secrets. Keep this file secret-free.
GEMINI_API_KEY=
GROQ_API_KEY=

# Local Docker default. For production, use a managed Postgres connection string
# with the pgvector extension enabled.
DATABASE_URL=postgresql://postgres:change-me-for-local-only@localhost:5432/verbamind
POSTGRES_PASSWORD=change-me-for-local-only

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hybrid-rag
